# ローカル開発用のHTTP待受アドレス
HTTP_ADDR=127.0.0.1:8080

# frontendのVITE_FIREBASE_PROJECT_IDと同じ値
FIREBASE_PROJECT_ID=
# ルート.envのDB設定に合わせる。本番環境はTLSを有効にする。
DATABASE_URL=postgres://reaction_race:local_dev_only@127.0.0.1:55432/reaction_race?sslmode=disable
# 開発時は管理用JSONをリポジトリ外へ保存して指定。通常のgcloudユーザー認証はFirebase Authで利用不可
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside/repository/service-account.json

# ブラウザで開くOriginと完全一致（末尾スラッシュなし）
APP_ORIGIN=http://127.0.0.1:5173
